# ============================================================
#  SLT Technology Group – LiteSpeed/Apache Server-Konfiguration
#  Liegt in public/ und wird von Vite nach dist/ kopiert.
# ============================================================

<IfModule mod_headers.c>
  # HTML: kurzer Browser-Cache, längerer CDN-Cache
  <FilesMatch "\.(html|htm)$">
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
  </FilesMatch>

  # Statische Assets mit Hash: 1 Jahr immutable
  <FilesMatch "\.(js|css|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>

  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # PDFs: moderat cachen
  <FilesMatch "\.pdf$">
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # sitemap.xml und robots.txt: kurz cachen
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Standard-Security-Header
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # X-Frame-Options bewusst NICHT gesetzt (Partner-Iframes erlaubt)
</IfModule>

# Gzip-Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================
#  Rewrite-Block: HTTPS + www erzwingen, danach SPA-Fallback
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) HTTPS + www erzwingen (Canonical: https://www.slt-tg.de)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.slt-tg\.de$ [NC]
  RewriteRule ^(.*)$ https://www.slt-tg.de/$1 [R=301,L]

  # 1b) Entferntes LED-Wartungskonzept: 410 Gone + noindex (Deindexierung)
  <IfModule mod_headers.c>
    <FilesMatch "(slt-wartungskonzept-outdoor-led|slt-outdoor-led-service-whitepaper-2026)\.pdf$">
      Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    </FilesMatch>
  </IfModule>
  RewriteRule ^downloads/slt-wartungskonzept-outdoor-led\.pdf$ - [G,L]
  RewriteRule ^downloads/slt-outdoor-led-service-whitepaper-2026\.pdf$ - [G,L]
  RewriteRule ^downloads/?$ - [G,L]


  # Services und Wartung dauerhaft im gemeinsamen Hub bündeln
  RewriteRule ^service-wartung/?$ /managed-services [R=301,L]

  # Legacy links: real permanent redirects, not client-only navigation
  RewriteRule ^leistungen/?$ /loesungen [R=301,L]
  RewriteRule ^blog/?$ /ratgeber [R=301,L]
  RewriteRule ^blog/(.+?)/?$ /ratgeber/$1 [R=301,L]

  # Direct requests to index.html consolidate on the public URL
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^(.+)/index\.html$ /$1 [R=301,L]

  # Slashless URLs for generated page directories (before mod_dir)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+[^/])$ $1/index.html [END]

  # Real static files only; unknown URLs and missing assets remain 404
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^$ index.html [L]
  RewriteRule ^ - [R=404,L]
</IfModule>

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
