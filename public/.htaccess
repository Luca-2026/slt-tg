# ============================================================
#  SLT Technology Group – LiteSpeed/Apache Server-Konfiguration
#  Liegt in public/ und wird von Vite nach dist/ kopiert.
# ============================================================

<IfModule mod_headers.c>
  # HTML: kurzer Browser-Cache, längerer CDN-Cache
  <FilesMatch "\.(html|htm)$">
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
  </FilesMatch>

  # Statische Assets mit Hash: 1 Jahr immutable
  <FilesMatch "\.(js|css|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # PDFs: moderat cachen
  <FilesMatch "\.pdf$">
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # sitemap.xml und robots.txt: kurz cachen
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Standard-Security-Header
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # X-Frame-Options bewusst NICHT gesetzt (Partner-Iframes erlaubt)
</IfModule>

# Gzip-Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================================
#  Rewrite-Block: HTTPS + www erzwingen, danach SPA-Fallback
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) HTTPS + www erzwingen (Canonical: https://www.slt-tg.de)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.slt-tg\.de$ [NC]
  RewriteRule ^(.*)$ https://www.slt-tg.de/$1 [R=301,L]

  # 2) Wenn Datei oder Verzeichnis existiert: direkt ausliefern
  #    (so werden prerendered /medientechnik/krefeld/index.html etc. genutzt)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) Sonst: SPA-Fallback auf root index.html
  RewriteRule ^ index.html [L]
</IfModule>
